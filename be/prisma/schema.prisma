  sites            sites           @relation(fields: [site_id], references: [site_id], onUpdate: NoAction, map: "FK_billable_charges_sites")
  unit_stays       unit_stays?     @relation(fields: [unit_stay_id], references: [unit_stay_id], onDelete: NoAction, onUpdate: NoAction, map: "FK_billable_charges_unit_stays")
