}

model lot_balance {
  lot_stay_id         BigInt    @id(map: "PK_lot_balance")
  uom                 String    @db.VarChar(10)
  package_type        String?   @db.VarChar(10)
  qty_received        Decimal   @db.Decimal(12, 3)
  qty_delivered       Decimal   @default(0, map: "DF_lot_balance_del") @db.Decimal(12, 3)
