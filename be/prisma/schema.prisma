generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model appointments {
  appointment_id           Int         @id(map: "PK__appointm__A50828FC54F8AB6F") @default(autoincrement())
  site_id                  Int
  visit_type_id            Int
  transporter_party_id     Int
  appointment_no           String      @unique(map: "UQ__appointm__A5090472411673D3") @db.NVarChar(50)
  truck_plate              String      @db.NVarChar(30)
  slot_start               DateTime
  slot_end                 DateTime
  status                   String?     @default("BOOKED", map: "DF__appointme__statu__511AFFBC") @db.NVarChar(30)
  created_at               DateTime?   @default(dbgenerated("sysutcdatetime()"), map: "DF__appointme__creat__520F23F5")
  appointments_parties     parties     @relation(fields: [transporter_party_id], references: [party_id], onUpdate: NoAction, map: "FK_appointments_transporters")
  appointments_sites       sites       @relation(fields: [site_id], references: [site_id], onUpdate: NoAction, map: "FK_appointments_sites")
  appointments_visit_types visit_types @relation(fields: [visit_type_id], references: [visit_type_id], onUpdate: NoAction, map: "FK_appointments_visit_types")
}

model approval_requests {
  approval_request_id                                 Int       @id(map: "PK__approval__AB34D1C8C921A4AF") @default(autoincrement())
  site_id                                             Int
  requested_by_user_id                                Int
  decided_by_user_id                                  Int?
  request_no                                          String    @unique(map: "UQ__approval__18D3F2FD472531DD") @db.NVarChar(50)
  permission_code                                     String    @db.NVarChar(100)
  entity_name                                         String    @db.NVarChar(50)
  entity_id                                           Int
  requested_amount                                    Decimal?  @db.Decimal(18, 2)
  currency                                            String?   @default("USD", map: "DF__approval___curre__5AD97420") @db.NVarChar(5)
  status                                              String?   @default("PENDING", map: "DF__approval___statu__5BCD9859") @db.NVarChar(30)
  requested_at                                        DateTime? @default(dbgenerated("sysutcdatetime()"), map: "DF__approval___reque__5CC1BC92")
  decided_at                                          DateTime?
  decision_notes                                      String?   @db.NVarChar(500)
  users_approval_requests_decided_by_user_idTousers   users?    @relation("approval_requests_decided_by_user_idTousers", fields: [decided_by_user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "FK_approval_requests_decided_by")
  users_approval_requests_requested_by_user_idTousers users     @relation("approval_requests_requested_by_user_idTousers", fields: [requested_by_user_id], references: [user_id], onUpdate: NoAction, map: "FK_approval_requests_requested_by")
  sites                                               sites     @relation(fields: [site_id], references: [site_id], onUpdate: NoAction, map: "FK_approval_requests_sites")
}

model invoice_line {
  invoice_line_id    BigInt         @id(map: "PK_invoice_line") @default(autoincrement())
  invoice_id         BigInt
  line_no            Int            @db.SmallInt
  line_doc_kind      String         @db.VarChar(12)
  charge_id          BigInt?
  disbursement_id    BigInt?
  credited_line_id   BigInt?
  charge_code_id     Int
  unit_stay_id       BigInt?
  description        String         @db.NVarChar(300)
  service_from       DateTime?      @db.Date
  service_to         DateTime?      @db.Date
  quantity           Decimal        @db.Decimal(12, 3)
  uom                String         @db.VarChar(10)
  unit_rate          Decimal        @db.Decimal(19, 6)
  amount             Decimal        @db.Decimal(19, 4)
  tax_code_id        Int?
  tax_rate_pct       Decimal        @default(0, map: "DF_invoice_line_tax_rate") @db.Decimal(6, 3)
  tax_amount         Decimal        @default(0, map: "DF_invoice_line_tax") @db.Decimal(19, 4)
  line_total         Decimal?       @db.Decimal(20, 4)
  createdate         DateTime       @default(dbgenerated("sysutcdatetime()"), map: "DF_invoice_line_createdate")
  updatedate         DateTime?
  createdby          String         @db.NVarChar(64)
  updatedby          String?        @db.NVarChar(64)
  log_inst           Int            @default(1, map: "DF_invoice_line_log_inst")
  charge             charge?        @relation(fields: [charge_id], references: [charge_id], onDelete: NoAction, onUpdate: NoAction, map: "FK_il_charge")
  m_charge_code      m_charge_code  @relation(fields: [charge_code_id], references: [charge_code_id], onUpdate: NoAction, map: "FK_il_charge_code")
  invoice_line       invoice_line?  @relation("invoice_lineToinvoice_line", fields: [credited_line_id], references: [invoice_line_id], onDelete: NoAction, onUpdate: NoAction, map: "FK_il_credited")
  other_invoice_line invoice_line[] @relation("invoice_lineToinvoice_line")
  disbursement       disbursement?  @relation(fields: [disbursement_id], references: [disbursement_id], onDelete: NoAction, onUpdate: NoAction, map: "FK_il_disbursement")
  invoice            invoice        @relation(fields: [invoice_id], references: [invoice_id], onUpdate: NoAction, map: "FK_il_invoice")
  unit_stay          unit_stay?     @relation(fields: [unit_stay_id], references: [unit_stay_id], onDelete: NoAction, onUpdate: NoAction, map: "FK_il_stay")
  m_tax_code         m_tax_code?    @relation(fields: [tax_code_id], references: [tax_code_id], onDelete: NoAction, onUpdate: NoAction, map: "FK_il_tax")

  @@unique([invoice_id, line_no], map: "UQ_invoice_line")
}

model key_custody {
  key_custody_id  BigInt           @id(map: "PK_key_custody") @default(autoincrement())
  unit_stay_id    BigInt           @unique(map: "UQ_key_custody_stay")
  key_tag_no      String           @db.VarChar(20)
  key_count       Int              @default(1, map: "DF_key_custody_count") @db.TinyInt
  has_remote      Boolean          @default(false, map: "DF_key_custody_remote")
  status          String           @default("IN_CABINET", map: "DF_key_custody_status") @db.VarChar(12)
  location_id     Int?
  holder_name     String?          @db.NVarChar(120)
  holder_sub      String?          @db.VarChar(64)
  createdate      DateTime         @default(dbgenerated("sysutcdatetime()"), map: "DF_key_custody_createdate")
  updatedate      DateTime?
  createdby       String           @db.NVarChar(64)
  updatedby       String?          @db.NVarChar(64)
  log_inst        Int              @default(1, map: "DF_key_custody_log_inst")
  m_yard_location m_yard_location? @relation(fields: [location_id], references: [yard_location_id], onDelete: NoAction, onUpdate: NoAction, map: "FK_key_custody_loc")
  unit_stay       unit_stay        @relation(fields: [unit_stay_id], references: [unit_stay_id], onUpdate: NoAction, map: "FK_key_custody_stay")
  key_movement    key_movement[]
}

model key_movement {
  key_movement_id BigInt           @id(map: "PK_key_movement") @default(autoincrement())
  key_custody_id  BigInt
  action          String           @db.VarChar(10)
  to_location_id  Int?
  to_holder_name  String?          @db.NVarChar(120)
  to_holder_sub   String?          @db.VarChar(64)
  reason          String?          @db.NVarChar(200)
  occurred_at     DateTime
  device_id       Int?
  createdate      DateTime         @default(dbgenerated("sysutcdatetime()"), map: "DF_key_movement_created")
  createdby       String           @db.NVarChar(64)
  key_custody     key_custody      @relation(fields: [key_custody_id], references: [key_custody_id], onUpdate: NoAction, map: "FK_key_movement_custody")
  m_device        m_device?        @relation(fields: [device_id], references: [device_id], onDelete: NoAction, onUpdate: NoAction, map: "FK_key_movement_device")
  m_yard_location m_yard_location? @relation(fields: [to_location_id], references: [yard_location_id], onDelete: NoAction, onUpdate: NoAction, map: "FK_key_movement_loc")

  @@index([key_custody_id, occurred_at], map: "IX_key_movement_custody")
}

model kpi_daily {
  site_id        Int
  kpi_date       DateTime @db.Date
  kpi_code       String   @db.VarChar(30)
  dimension_kind String   @default("", map: "DF_kpi_daily_dim_kind") @db.VarChar(20)
  dimension_key  String   @default("", map: "DF_kpi_daily_dim_key") @db.VarChar(40)
  value          Decimal  @db.Decimal(19, 4)
  sample_size    Int?
  computed_at    DateTime @default(dbgenerated("sysutcdatetime()"), map: "DF_kpi_daily_computed")
  m_site         m_site   @relation(fields: [site_id], references: [site_id], onUpdate: NoAction, map: "FK_kpi_daily_site")

  @@id([site_id, kpi_date, kpi_code, dimension_kind, dimension_key], map: "PK_kpi_daily")
  @@index([kpi_code, kpi_date], map: "IX_kpi_daily_code")
}

model labour_contractor {
  labour_contractor_id Int            @id(map: "PK_labour_contractor") @default(autoincrement())
  site_id              Int
  party_id             Int?
  contractor_name      String         @db.NVarChar(120)
