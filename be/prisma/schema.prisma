  createdate        DateTime       @default(dbgenerated("sysutcdatetime()"), map: "DF_lot_delivery_createdate")
  updatedate        DateTime?
  createdby         String         @db.NVarChar(64)
  updatedby         String?        @db.NVarChar(64)
  log_inst          Int            @default(1, map: "DF_lot_delivery_log_inst")
  unit_stay         unit_stay      @relation(fields: [lot_stay_id], references: [unit_stay_id], onUpdate: NoAction, map: "FK_ld_lot")
  visit_unit_txn    visit_unit_txn @relation(fields: [visit_unit_txn_id], references: [visit_unit_txn_id], onUpdate: NoAction, map: "FK_ld_txn")

  @@unique([visit_unit_txn_id, lot_stay_id], map: "UQ_lot_delivery")
