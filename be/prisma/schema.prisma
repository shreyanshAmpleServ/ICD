  updatedate            DateTime?
  createdby             String            @db.NVarChar(64)
  updatedby             String?           @db.NVarChar(64)
  log_inst              Int               @default(1, map: "DF_weighing_log_inst")
  m_device              m_device?         @relation(fields: [device_id], references: [device_id], onDelete: NoAction, onUpdate: NoAction, map: "FK_weighing_device")
  approval_request      approval_request? @relation(fields: [override_approval_ref], references: [approval_request_id], onDelete: NoAction, onUpdate: NoAction, map: "FK_weighing_override_approval")
  m_site                m_site            @relation(fields: [site_id], references: [site_id], onUpdate: NoAction, map: "FK_weighing_site")
  unit_stay             unit_stay?        @relation(fields: [unit_stay_id], references: [unit_stay_id], onDelete: NoAction, onUpdate: NoAction, map: "FK_weighing_stay")
  truck_visit           truck_visit?      @relation(fields: [truck_visit_id], references: [truck_visit_id], onDelete: NoAction, onUpdate: NoAction, map: "FK_weighing_visit")

  @@unique([site_id, ticket_no], map: "UQ_weighing_ticket")
}

model yard_move {
  yard_move_id                                                BigInt           @id(map: "PK_yard_move") @default(autoincrement())
  site_id                                                     Int
  unit_stay_id                                                BigInt
  move_order_id                                               BigInt?
  move_kind                                                   String           @db.VarChar(14)
  from_location_id                                            Int?
  to_location_id                                              Int?
  equipment_id                                                Int?
  operator_sub                                                String           @db.VarChar(64)
  occurred_at                                                 DateTime
  reason                                                      String?          @db.NVarChar(300)
  device_id                                                   Int?
  is_offline                                                  Boolean          @default(false, map: "DF_yard_move_offline")
  client_txn_id                                               String?          @db.UniqueIdentifier
  createdate                                                  DateTime         @default(dbgenerated("sysutcdatetime()"), map: "DF_yard_move_created")
  createdby                                                   String           @db.NVarChar(64)
  m_device                                                    m_device?        @relation(fields: [device_id], references: [device_id], onDelete: NoAction, onUpdate: NoAction, map: "FK_yard_move_device")
  m_equipment                                                 m_equipment?     @relation(fields: [equipment_id], references: [equipment_id], onDelete: NoAction, onUpdate: NoAction, map: "FK_yard_move_equipment")
  m_yard_location_yard_move_from_location_idTom_yard_location m_yard_location? @relation("yard_move_from_location_idTom_yard_location", fields: [from_location_id], references: [yard_location_id], onDelete: NoAction, onUpdate: NoAction, map: "FK_yard_move_from")
  move_order                                                  move_order?      @relation(fields: [move_order_id], references: [move_order_id], onDelete: NoAction, onUpdate: NoAction, map: "FK_yard_move_order")
  m_site                                                      m_site           @relation(fields: [site_id], references: [site_id], onUpdate: NoAction, map: "FK_yard_move_site")
  unit_stay                                                   unit_stay        @relation(fields: [unit_stay_id], references: [unit_stay_id], onUpdate: NoAction, map: "FK_yard_move_stay")
  m_yard_location_yard_move_to_location_idTom_yard_location   m_yard_location? @relation("yard_move_to_location_idTom_yard_location", fields: [to_location_id], references: [yard_location_id], onDelete: NoAction, onUpdate: NoAction, map: "FK_yard_move_to")

  @@index([site_id, occurred_at], map: "IX_yard_move_site_time")
  @@index([unit_stay_id, occurred_at], map: "IX_yard_move_stay")
}

model yard_occupancy {
  yard_occupancy_id BigInt          @id(map: "PK_yard_occupancy") @default(autoincrement())
  yard_location_id  Int
  unit_stay_id      BigInt
  is_primary        Boolean         @default(true, map: "DF_yard_occupancy_primary")
  exclusive         Boolean         @default(true, map: "DF_yard_occupancy_excl")
  occupied_since    DateTime
  createdate        DateTime        @default(dbgenerated("sysutcdatetime()"), map: "DF_yard_occupancy_createdate")
  updatedate        DateTime?
  createdby         String          @db.NVarChar(64)
  updatedby         String?         @db.NVarChar(64)
  log_inst          Int             @default(1, map: "DF_yard_occupancy_log_inst")
  m_yard_location   m_yard_location @relation(fields: [yard_location_id], references: [yard_location_id], onUpdate: NoAction, map: "FK_yard_occupancy_loc")
  unit_stay         unit_stay       @relation(fields: [unit_stay_id], references: [unit_stay_id], onUpdate: NoAction, map: "FK_yard_occupancy_stay")

  @@index([unit_stay_id], map: "IX_yard_occupancy_unit_all")
}

model yard_suggestion_log {
  yard_suggestion_log_id BigInt            @id(map: "PK_yard_suggestion_log") @default(autoincrement())
  site_id                Int
  unit_stay_id           BigInt
  move_order_id          BigInt?
  engine                 String            @db.VarChar(10)
  ml_model_version_id    Int?
  candidates_json        String            @db.NVarChar(Max)
  chosen_location_id     Int?
  chosen_rank            Int?              @db.TinyInt
  override_reason        String?           @db.NVarChar(300)
  suggested_at           DateTime          @default(dbgenerated("sysutcdatetime()"), map: "DF_ysl_at")
  m_yard_location        m_yard_location?  @relation(fields: [chosen_location_id], references: [yard_location_id], onDelete: NoAction, onUpdate: NoAction, map: "FK_ysl_location")
  ml_model_version       ml_model_version? @relation(fields: [ml_model_version_id], references: [ml_model_version_id], onDelete: NoAction, onUpdate: NoAction, map: "FK_ysl_model")
  move_order             move_order?       @relation(fields: [move_order_id], references: [move_order_id], onDelete: NoAction, onUpdate: NoAction, map: "FK_ysl_order")
  m_site                 m_site            @relation(fields: [site_id], references: [site_id], onUpdate: NoAction, map: "FK_ysl_site")
  unit_stay              unit_stay         @relation(fields: [unit_stay_id], references: [unit_stay_id], onUpdate: NoAction, map: "FK_ysl_stay")

  @@index([site_id, suggested_at], map: "IX_ysl_site_time")
}
