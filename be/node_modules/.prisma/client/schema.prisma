  seq_no                    Int               @db.TinyInt
  result                    String            @db.VarChar(10)
  failure_reason            String?           @db.NVarChar(300)
  override_approval_ref     BigInt?
  gate_lane_id              Int?
  plate_read                String?           @db.VarChar(20)
  plate_source              String?           @db.VarChar(6)
  anpr_confidence           Decimal?          @db.Decimal(5, 2)
  occurred_at               DateTime
  device_id                 Int?
  is_offline                Boolean           @default(false, map: "DF_vce_offline")
  client_txn_id             String?           @db.UniqueIdentifier
  createdate                DateTime          @default(dbgenerated("sysutcdatetime()"), map: "DF_vce_created")
  createdby                 String            @db.NVarChar(64)
  m_checkpoint              m_checkpoint      @relation(fields: [checkpoint_id], references: [checkpoint_id], onUpdate: NoAction, map: "FK_vce_checkpoint")
  m_device                  m_device?         @relation(fields: [device_id], references: [device_id], onDelete: NoAction, onUpdate: NoAction, map: "FK_vce_device")
  m_gate_lane               m_gate_lane?      @relation(fields: [gate_lane_id], references: [gate_lane_id], onDelete: NoAction, onUpdate: NoAction, map: "FK_vce_lane")
  approval_request          approval_request? @relation(fields: [override_approval_ref], references: [approval_request_id], onDelete: NoAction, onUpdate: NoAction, map: "FK_vce_override_approval")
  truck_visit               truck_visit       @relation(fields: [truck_visit_id], references: [truck_visit_id], onUpdate: NoAction, map: "FK_vce_visit")

