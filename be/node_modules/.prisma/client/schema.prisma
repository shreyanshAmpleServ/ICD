  seal_found            String?              @db.VarChar(30)
  seal_applied          String?              @db.VarChar(30)
  seal_status           String?              @db.VarChar(12)
  eir_no                String?              @db.VarChar(30)
  signature_mode        String?              @db.VarChar(6)
