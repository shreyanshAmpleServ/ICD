generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model accounting_period {
  accounting_period_id Int       @id(map: "PK_accounting_period") @default(autoincrement())
  company_id           Int
  period_key           String    @db.Char(7)
  period_start         DateTime  @db.Date
  period_end           DateTime  @db.Date
  status               String    @default("OPEN", map: "DF_accounting_period_status") @db.VarChar(8)
  closed_at            DateTime?
  closed_by_sub        String?   @db.VarChar(64)
  reopened_count       Int       @default(0, map: "DF_accounting_period_reopen") @db.TinyInt
  createdate           DateTime  @default(dbgenerated("sysutcdatetime()"), map: "DF_accounting_period_createdate")
  updatedate           DateTime?
  createdby            String    @db.NVarChar(64)
  updatedby            String?   @db.NVarChar(64)
  log_inst             Int       @default(1, map: "DF_accounting_period_log_inst")
  m_company            m_company @relation(fields: [company_id], references: [company_id], onUpdate: NoAction, map: "FK_accounting_period_company")
  invoice              invoice[]
  payment              payment[]

  @@unique([company_id, period_key], map: "UQ_accounting_period")
}

model aiva_conversation {
  aiva_conversation_id String         @id(map: "PK_aiva_conversation") @default(dbgenerated("newsequentialid()"), map: "DF_aiva_conv_id") @db.UniqueIdentifier
  user_id              Int
  site_id              Int?
  surface              String         @default("ICD_PANEL", map: "DF_aiva_conv_surface") @db.VarChar(10)
  context_entity       String?        @db.VarChar(40)
  context_id           BigInt?
  started_at           DateTime       @default(dbgenerated("sysutcdatetime()"), map: "DF_aiva_conv_started")
  last_message_at      DateTime?
  m_site               m_site?        @relation(fields: [site_id], references: [site_id], onDelete: NoAction, onUpdate: NoAction, map: "FK_aiva_conv_site")
  app_user             app_user       @relation(fields: [user_id], references: [user_id], onUpdate: NoAction, map: "FK_aiva_conv_user")
  aiva_message         aiva_message[]

  @@index([user_id, started_at], map: "IX_aiva_conv_user")
}

model aiva_draft_action {
  aiva_draft_action_id BigInt            @id(map: "PK_aiva_draft_action") @default(autoincrement())
  aiva_message_id      BigInt
  action_kind          String            @db.VarChar(30)
  target_entity        String?           @db.VarChar(40)
  target_ids_json      String?           @db.NVarChar(Max)
  payload_json         String            @db.NVarChar(Max)
  status               String            @default("DRAFT", map: "DF_ada_status") @db.VarChar(10)
  submitted_by_sub     String?           @db.VarChar(64)
  submitted_at         DateTime?
  approval_request_id  BigInt?
  result_entity        String?           @db.VarChar(40)
  result_id            BigInt?
  createdate           DateTime          @default(dbgenerated("sysutcdatetime()"), map: "DF_ada_created")
  updatedate           DateTime?
  approval_request     approval_request? @relation(fields: [approval_request_id], references: [approval_request_id], onDelete: NoAction, onUpdate: NoAction, map: "FK_ada_approval")
  aiva_message         aiva_message      @relation(fields: [aiva_message_id], references: [aiva_message_id], onUpdate: NoAction, map: "FK_ada_message")
}

model aiva_message {
  aiva_message_id      BigInt              @id(map: "PK_aiva_message") @default(autoincrement())
  aiva_conversation_id String              @db.UniqueIdentifier
  role                 String              @db.VarChar(10)
  content              String              @db.NVarChar(Max)
  model                String?             @db.VarChar(60)
  input_tokens         Int?
  output_tokens        Int?
  latency_ms           Int?
  feedback             Int?                @db.SmallInt
  feedback_note        String?             @db.NVarChar(400)
  createdate           DateTime            @default(dbgenerated("sysutcdatetime()"), map: "DF_aiva_message_created")
  aiva_draft_action    aiva_draft_action[]
  aiva_conversation    aiva_conversation   @relation(fields: [aiva_conversation_id], references: [aiva_conversation_id], onUpdate: NoAction, map: "FK_aiva_message_conv")
  aiva_tool_call       aiva_tool_call[]

  @@index([aiva_conversation_id, createdate], map: "IX_aiva_message_conv")
}

model aiva_tool_call {
  aiva_tool_call_id BigInt       @id(map: "PK_aiva_tool_call") @default(autoincrement())
  aiva_message_id   BigInt
  tool_name         String       @db.VarChar(60)
  arguments_json    String?      @db.NVarChar(Max)
  result_summary    String?      @db.NVarChar(500)
  was_denied        Boolean      @default(false, map: "DF_aiva_tool_denied")
  duration_ms       Int?
  createdate        DateTime     @default(dbgenerated("sysutcdatetime()"), map: "DF_aiva_tool_created")
  aiva_message      aiva_message @relation(fields: [aiva_message_id], references: [aiva_message_id], onUpdate: NoAction, map: "FK_aiva_tool_message")

  @@index([aiva_message_id], map: "IX_aiva_tool_message")
  @@index([tool_name, createdate], map: "IX_aiva_tool_name")
}

model api_idempotency {
  idempotency_key String   @id(map: "PK_api_idempotency") @db.UniqueIdentifier
  user_sub        String   @db.VarChar(64)
  device_id       Int?
  endpoint        String   @db.VarChar(120)
  request_sha256  String   @db.Char(64)
  response_status Int?     @db.SmallInt
  response_json   String?  @db.NVarChar(Max)
  created_at      DateTime @default(dbgenerated("sysutcdatetime()"), map: "DF_api_idempotency_created")
  expires_at      DateTime

  @@index([expires_at], map: "IX_api_idempotency_expires")
}

model app_user {
  user_id                                                        Int                   @id(map: "PK_app_user") @default(autoincrement())
  user_sub                                                       String                @unique(map: "UQ_app_user_sub") @db.VarChar(64)
  user_name                                                      String                @db.NVarChar(120)
  email                                                          String?               @db.VarChar(200)
  phone                                                          String?               @db.VarChar(30)
  party_id                                                       Int?
  preferred_language                                             String                @default("en", map: "DF_app_user_lang") @db.Char(2)
  is_ng_user                                                     Boolean               @default(true, map: "DF_app_user_is_ng")
  mfa_required                                                   Boolean               @default(false, map: "DF_app_user_mfa")
  last_login_at                                                  DateTime?
  is_active                                                      Boolean               @default(true, map: "DF_app_user_is_active")
  createdate                                                     DateTime              @default(dbgenerated("sysutcdatetime()"), map: "DF_app_user_createdate")
  updatedate                                                     DateTime?
  createdby                                                      String                @db.NVarChar(64)
  updatedby                                                      String?               @db.NVarChar(64)
  log_inst                                                       Int                   @default(1, map: "DF_app_user_log_inst")
  aiva_conversation                                              aiva_conversation[]
  m_party                                                        m_party?              @relation(fields: [party_id], references: [party_id], onDelete: NoAction, onUpdate: NoAction, map: "FK_app_user_party")
  approval_delegation_approval_delegation_from_user_idToapp_user approval_delegation[] @relation("approval_delegation_from_user_idToapp_user")
  approval_delegation_approval_delegation_to_user_idToapp_user   approval_delegation[] @relation("approval_delegation_to_user_idToapp_user")
  notification                                                   notification[]
  portal_invitation                                              portal_invitation[]
  saved_report                                                   saved_report[]
  user_site_role                                                 user_site_role[]
}

model appointment {
  appointment_id       BigInt         @id(map: "PK_appointment") @default(autoincrement())
  site_id              Int
  appointment_no       String         @db.VarChar(30)
  visit_type_id        Int
  slot_start           DateTime
  slot_end             DateTime
  transporter_party_id Int
  truck_id             Int?
  driver_id            Int?
  release_order_id     BigInt?
  consignment_id       BigInt?
  status               String         @default("BOOKED", map: "DF_appointment_status") @db.VarChar(10)
  truck_visit_id       BigInt?
  booked_via           String         @default("PORTAL", map: "DF_appointment_via") @db.VarChar(8)
  cancel_reason        String?        @db.NVarChar(200)
  createdate           DateTime       @default(dbgenerated("sysutcdatetime()"), map: "DF_appointment_createdate")
  updatedate           DateTime?
  createdby            String         @db.NVarChar(64)
  updatedby            String?        @db.NVarChar(64)
  log_inst             Int            @default(1, map: "DF_appointment_log_inst")
  consignment          consignment?   @relation(fields: [consignment_id], references: [consignment_id], onDelete: NoAction, onUpdate: NoAction, map: "FK_appointment_consignment")
  m_driver             m_driver?      @relation(fields: [driver_id], references: [driver_id], onDelete: NoAction, onUpdate: NoAction, map: "FK_appointment_driver")
  release_order        release_order? @relation(fields: [release_order_id], references: [release_order_id], onDelete: NoAction, onUpdate: NoAction, map: "FK_appointment_release")
  m_site               m_site         @relation(fields: [site_id], references: [site_id], onUpdate: NoAction, map: "FK_appointment_site")
  m_party              m_party        @relation(fields: [transporter_party_id], references: [party_id], onUpdate: NoAction, map: "FK_appointment_transporter")
  m_truck              m_truck?       @relation(fields: [truck_id], references: [truck_id], onDelete: NoAction, onUpdate: NoAction, map: "FK_appointment_truck")
  truck_visit          truck_visit?   @relation(fields: [truck_visit_id], references: [truck_visit_id], onDelete: NoAction, onUpdate: NoAction, map: "FK_appointment_visit")
  m_visit_type         m_visit_type   @relation(fields: [visit_type_id], references: [visit_type_id], onUpdate: NoAction, map: "FK_appointment_visit_type")

  @@unique([site_id, appointment_no], map: "UQ_appointment_no")
}

model approval_delegation {
  approval_delegation_id                              Int           @id(map: "PK_approval_delegation") @default(autoincrement())
  from_user_id                                        Int
  to_user_id                                          Int
  permission_code                                     String?       @db.VarChar(80)
  site_id                                             Int?
  valid_from                                          DateTime
  valid_to                                            DateTime
  reason                                              String        @db.NVarChar(200)
  revoked_at                                          DateTime?
  createdate                                          DateTime      @default(dbgenerated("sysutcdatetime()"), map: "DF_approval_delegation_createdate")
  updatedate                                          DateTime?
  createdby                                           String        @db.NVarChar(64)
  updatedby                                           String?       @db.NVarChar(64)
  log_inst                                            Int           @default(1, map: "DF_approval_delegation_log_inst")
  app_user_approval_delegation_from_user_idToapp_user app_user      @relation("approval_delegation_from_user_idToapp_user", fields: [from_user_id], references: [user_id], onUpdate: NoAction, map: "FK_ad_from")
  m_permission                                        m_permission? @relation(fields: [permission_code], references: [permission_code], onDelete: NoAction, onUpdate: NoAction, map: "FK_ad_perm")
  m_site                                              m_site?       @relation(fields: [site_id], references: [site_id], onDelete: NoAction, onUpdate: NoAction, map: "FK_ad_site")
  app_user_approval_delegation_to_user_idToapp_user   app_user      @relation("approval_delegation_to_user_idToapp_user", fields: [to_user_id], references: [user_id], onUpdate: NoAction, map: "FK_ad_to")

  @@index([to_user_id, valid_from, valid_to], map: "IX_ad_to_user")
}

model approval_request {
  approval_request_id     BigInt                    @id(map: "PK_approval_request") @default(autoincrement())
  site_id                 Int?
  request_no              String                    @unique(map: "UQ_approval_request_no") @db.VarChar(30)
  permission_code         String                    @db.VarChar(80)
  entity_name             String                    @db.VarChar(40)
  entity_id               BigInt
  summary                 String                    @db.NVarChar(300)
  reason                  String                    @db.NVarChar(800)
  amount                  Decimal?                  @db.Decimal(19, 4)
  amount_currency         String?                   @db.Char(3)
  payload_json            String?                   @db.NVarChar(Max)
  levels_required         Int                       @default(1, map: "DF_approval_request_levels") @db.TinyInt
  current_level           Int                       @default(1, map: "DF_approval_request_level") @db.TinyInt
  status                  String                    @default("PENDING", map: "DF_approval_request_status") @db.VarChar(10)
  requested_by_sub        String                    @db.VarChar(64)
  requested_at            DateTime                  @default(dbgenerated("sysutcdatetime()"), map: "DF_approval_request_at")
  expires_at              DateTime?
  decided_at              DateTime?
  applied_at              DateTime?
  createdate              DateTime                  @default(dbgenerated("sysutcdatetime()"), map: "DF_approval_request_createdate")
  updatedate              DateTime?
  createdby               String                    @db.NVarChar(64)
  updatedby               String?                   @db.NVarChar(64)
  log_inst                Int                       @default(1, map: "DF_approval_request_log_inst")
  aiva_draft_action       aiva_draft_action[]
  m_currency              m_currency?               @relation(fields: [amount_currency], references: [currency_code], onDelete: NoAction, onUpdate: NoAction, map: "FK_approval_request_currency")
  m_permission            m_permission              @relation(fields: [permission_code], references: [permission_code], onUpdate: NoAction, map: "FK_approval_request_perm")
  m_site                  m_site?                   @relation(fields: [site_id], references: [site_id], onDelete: NoAction, onUpdate: NoAction, map: "FK_approval_request_site")
  approval_step           approval_step[]
  cashier_shift           cashier_shift[]
  charge                  charge[]
  disbursement            disbursement[]
  exception_case          exception_case[]
  hold                    hold[]
  invoice                 invoice[]
  refund                  refund[]
  release_check           release_check[]
  release_order           release_order[]
  release_validity_change release_validity_change[]
  tariff                  tariff[]
  visit_checkpoint_event  visit_checkpoint_event[]
  weighing                weighing[]

  @@index([entity_name, entity_id], map: "IX_approval_request_entity")
}

model approval_step {
  approval_step_id    BigInt           @id(map: "PK_approval_step") @default(autoincrement())
  approval_request_id BigInt
  level_no            Int              @db.TinyInt
  decision            String           @db.VarChar(8)
  decided_by_sub      String           @db.VarChar(64)
  requested_by_sub    String           @db.VarChar(64)
  on_behalf_of_sub    String?          @db.VarChar(64)
  decision_note       String?          @db.NVarChar(500)
  decided_at          DateTime         @default(dbgenerated("sysutcdatetime()"), map: "DF_approval_step_at")
  createdate          DateTime         @default(dbgenerated("sysutcdatetime()"), map: "DF_approval_step_created")
  createdby           String           @db.NVarChar(64)
  approval_request    approval_request @relation(fields: [approval_request_id], references: [approval_request_id], onUpdate: NoAction, map: "FK_approval_step_request")

  @@unique([approval_request_id, level_no], map: "UQ_approval_step_level")
  @@unique([approval_request_id, decided_by_sub], map: "UQ_approval_step_person")
}

model audit_log {
  audit_log_id        BigInt   @id(map: "PK_audit_log") @default(autoincrement())
  occurred_at         DateTime @default(dbgenerated("sysutcdatetime()"), map: "DF_audit_log_occurred")
  user_sub            String   @db.VarChar(64)
  user_name           String?  @db.NVarChar(120)
  device_id           Int?
  ip_address          String?  @db.VarChar(45)
  site_id             Int?
  entity_name         String   @db.VarChar(60)
  entity_id           String   @db.VarChar(64)
  action              String   @db.VarChar(20)
  reason              String?  @db.NVarChar(500)
  changes_json        String?  @db.NVarChar(Max)
  correlation_id      String?  @db.UniqueIdentifier
  approval_request_id BigInt?
  source              String   @default("UI", map: "DF_audit_log_source") @db.VarChar(10)

  @@index([entity_name, entity_id, occurred_at], map: "IX_audit_log_entity")
  @@index([occurred_at], map: "IX_audit_log_time")
  @@index([user_sub, occurred_at], map: "IX_audit_log_user")
}

model billable_event {
  billable_event_id BigInt        @id(map: "PK_billable_event") @default(autoincrement())
  site_id           Int
  charge_code_id    Int
  dedupe_key        String        @unique(map: "UQ_billable_event_dedupe") @db.VarChar(100)
  unit_stay_id      BigInt?
  truck_visit_id    BigInt?
  consignment_id    BigInt?
  bill_to_party_id  Int?
  source_entity     String        @db.VarChar(40)
  source_id         BigInt?
  service_date      DateTime      @db.Date
  occurred_at       DateTime
  quantity          Decimal       @default(1, map: "DF_billable_event_qty") @db.Decimal(12, 3)
  uom               String        @default("UNIT", map: "DF_billable_event_uom") @db.VarChar(10)
  day_no            Int?
  status            String        @default("UNRATED", map: "DF_billable_event_status") @db.VarChar(10)
  rated_at          DateTime?
  createdate        DateTime      @default(dbgenerated("sysutcdatetime()"), map: "DF_billable_event_createdate")
  updatedate        DateTime?
  createdby         String        @db.NVarChar(64)
  updatedby         String?       @db.NVarChar(64)
  log_inst          Int           @default(1, map: "DF_billable_event_log_inst")
  m_party           m_party?      @relation(fields: [bill_to_party_id], references: [party_id], onDelete: NoAction, onUpdate: NoAction, map: "FK_be_bill_to")
  m_charge_code     m_charge_code @relation(fields: [charge_code_id], references: [charge_code_id], onUpdate: NoAction, map: "FK_be_charge")
  consignment       consignment?  @relation(fields: [consignment_id], references: [consignment_id], onDelete: NoAction, onUpdate: NoAction, map: "FK_be_consignment")
  m_site            m_site        @relation(fields: [site_id], references: [site_id], onUpdate: NoAction, map: "FK_be_site")
  unit_stay         unit_stay?    @relation(fields: [unit_stay_id], references: [unit_stay_id], onDelete: NoAction, onUpdate: NoAction, map: "FK_be_stay")
  truck_visit       truck_visit?  @relation(fields: [truck_visit_id], references: [truck_visit_id], onDelete: NoAction, onUpdate: NoAction, map: "FK_be_visit")
  charge            charge[]
}

model cargo_unit {
  cargo_unit_id    BigInt           @id(map: "PK_cargo_unit") @default(autoincrement())
  unit_category    String           @db.VarChar(10)
  unit_no          String           @db.VarChar(40)
  unit_type_id     Int
  owner_party_id   Int?
  identity_rule_id Int?
  engine_no        String?          @db.VarChar(30)
  make             String?          @db.NVarChar(40)
  model            String?          @db.NVarChar(60)
  model_year       Int?             @db.SmallInt
  colour           String?          @db.NVarChar(30)
  tare_kg          Int?
  max_gross_kg     Int?
  createdate       DateTime         @default(dbgenerated("sysutcdatetime()"), map: "DF_cargo_unit_createdate")
  updatedate       DateTime?
  createdby        String           @db.NVarChar(64)
  updatedby        String?          @db.NVarChar(64)
  log_inst         Int              @default(1, map: "DF_cargo_unit_log_inst")
  m_party          m_party?         @relation(fields: [owner_party_id], references: [party_id], onDelete: NoAction, onUpdate: NoAction, map: "FK_cargo_unit_owner")
  m_identity_rule  m_identity_rule? @relation(fields: [identity_rule_id], references: [identity_rule_id], onDelete: NoAction, onUpdate: NoAction, map: "FK_cargo_unit_rule")
  m_unit_type      m_unit_type      @relation(fields: [unit_type_id], references: [unit_type_id], onUpdate: NoAction, map: "FK_cargo_unit_type")
  unit_stay        unit_stay[]

  @@unique([unit_category, unit_no], map: "UQ_cargo_unit")
  @@index([unit_no], map: "IX_cargo_unit_no")
}

model cashier_shift {
  cashier_shift_id    BigInt            @id(map: "PK_cashier_shift") @default(autoincrement())
  site_id             Int
  cashier_sub         String            @db.VarChar(64)
  currency            String            @db.Char(3)
  opened_at           DateTime
  closed_at           DateTime?
  opening_float       Decimal           @default(0, map: "DF_cashier_shift_float") @db.Decimal(19, 4)
  expected_cash       Decimal?          @db.Decimal(19, 4)
  counted_cash        Decimal?          @db.Decimal(19, 4)
  difference          Decimal?          @db.Decimal(20, 4)
  status              String            @default("OPEN", map: "DF_cashier_shift_status") @db.VarChar(10)
  approval_request_id BigInt?
  createdate          DateTime          @default(dbgenerated("sysutcdatetime()"), map: "DF_cashier_shift_createdate")
  updatedate          DateTime?
  createdby           String            @db.NVarChar(64)
  updatedby           String?           @db.NVarChar(64)
  log_inst            Int               @default(1, map: "DF_cashier_shift_log_inst")
  approval_request    approval_request? @relation(fields: [approval_request_id], references: [approval_request_id], onDelete: NoAction, onUpdate: NoAction, map: "FK_cs_approval")
  m_currency          m_currency        @relation(fields: [currency], references: [currency_code], onUpdate: NoAction, map: "FK_cs_currency")
  m_site              m_site            @relation(fields: [site_id], references: [site_id], onUpdate: NoAction, map: "FK_cs_site")
  payment             payment[]
}

model charge {
  charge_id             BigInt            @id(map: "PK_charge") @default(autoincrement())
  billable_event_id     BigInt
  bill_to_party_id      Int
  tariff_id             Int?
  tariff_rule_id        Int?
  tariff_slab_id        Int?
  currency              String            @db.Char(3)
  quantity              Decimal           @db.Decimal(12, 3)
  unit_rate             Decimal           @db.Decimal(19, 6)
  amount                Decimal           @db.Decimal(19, 4)
  tax_code_id           Int?
  tax_rate_pct          Decimal           @default(0, map: "DF_charge_tax_rate") @db.Decimal(6, 3)
  tax_amount            Decimal           @default(0, map: "DF_charge_tax_amount") @db.Decimal(19, 4)
  charge_kind           String            @default("NORMAL", map: "DF_charge_kind") @db.VarChar(10)
  reverses_charge_id    BigInt?
  approval_request_id   BigInt?
  status                String            @default("OPEN", map: "DF_charge_status") @db.VarChar(12)
  rating_correlation_id String?           @db.UniqueIdentifier
  rated_at              DateTime          @default(dbgenerated("sysutcdatetime()"), map: "DF_charge_rated")
  createdate            DateTime          @default(dbgenerated("sysutcdatetime()"), map: "DF_charge_createdate")
  updatedate            DateTime?
  createdby             String            @db.NVarChar(64)
  updatedby             String?           @db.NVarChar(64)
  log_inst              Int               @default(1, map: "DF_charge_log_inst")
  approval_request      approval_request? @relation(fields: [approval_request_id], references: [approval_request_id], onDelete: NoAction, onUpdate: NoAction, map: "FK_charge_approval")
  m_party               m_party           @relation(fields: [bill_to_party_id], references: [party_id], onUpdate: NoAction, map: "FK_charge_bill_to")
  m_currency            m_currency        @relation(fields: [currency], references: [currency_code], onUpdate: NoAction, map: "FK_charge_currency")
  billable_event        billable_event    @relation(fields: [billable_event_id], references: [billable_event_id], onUpdate: NoAction, map: "FK_charge_event")
  charge                charge?           @relation("chargeTocharge", fields: [reverses_charge_id], references: [charge_id], onDelete: NoAction, onUpdate: NoAction, map: "FK_charge_reverses")
  other_charge          charge[]          @relation("chargeTocharge")
  tariff_rule           tariff_rule?      @relation(fields: [tariff_rule_id], references: [tariff_rule_id], onDelete: NoAction, onUpdate: NoAction, map: "FK_charge_rule")
  tariff_slab           tariff_slab?      @relation(fields: [tariff_slab_id], references: [tariff_slab_id], onDelete: NoAction, onUpdate: NoAction, map: "FK_charge_slab")
  tariff                tariff?           @relation(fields: [tariff_id], references: [tariff_id], onDelete: NoAction, onUpdate: NoAction, map: "FK_charge_tariff")
