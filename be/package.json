{
  "name": "ng-icd-be",
  "version": "1.0.0",
  "description": "DCC NG ICD Backend API - Modular Node.js + Express + Prisma MSSQL",
  "main": "dist/index.js",
  "scripts": {
    "dev": "node ./node_modules/tsx/dist/cli.mjs watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "prisma:generate": "node ./node_modules/prisma/build/index.js generate",
    "prisma:db-pull": "node ./node_modules/prisma/build/index.js db pull",
    "prisma:db-push": "node ./node_modules/prisma/build/index.js db push",
    "prisma:migrate": "node ./node_modules/prisma/build/index.js migrate dev",
    "prisma:seed": "node ./node_modules/tsx/dist/cli.mjs src/scripts/seed.ts"
  },
  "keywords": [
    "icd",
    "container-terminal",
    "express",
    "mssql",
    "prisma",
    "typescript"
  ],
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "morgan": "^1.10.0",
    "mssql": "^11.0.1",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.9.1",
    "yamljs": "^0.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/mssql": "^9.0.3",
    "@types/node": "^22.9.0",
    "@types/swagger-ui-express": "^4.1.7",
    "@types/yamljs": "^0.2.34",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
