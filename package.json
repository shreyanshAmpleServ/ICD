{
  "name": "ng-icd",
  "version": "1.0.0",
  "private": true,
  "description": "DCC NG ICD Monorepo Orchestration",
  "scripts": {
    "dev": "concurrently -k -n \"BACKEND,FRONTEND\" -c \"blue.bold,green.bold\" \"npm run dev:be\" \"npm run dev:fe\"",
    "dev:be": "npm run dev --prefix be",
    "dev:fe": "npm run dev --prefix fe",
    "build": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue.bold,green.bold\" \"npm run build:be\" \"npm run build:fe\"",
    "build:be": "npm run build --prefix be",
    "build:fe": "npm run build --prefix fe",
    "start": "concurrently -k -n \"BACKEND,FRONTEND\" -c \"blue.bold,green.bold\" \"npm run start:be\" \"npm run start:fe\"",
    "start:be": "npm run start --prefix be",
    "start:fe": "npm run start --prefix fe",
    "build:start": "npm run build && npm run start",
    "install:all": "npm install && npm install --prefix be && npm install --prefix fe"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
